# W&B API key. Used for both CoreWeave Serverless Inference and Weave trace ingest.
WANDB_API_KEY=

# Weave team (entity) and project the traces go to.
WANDB_ENTITY=your-team
WANDB_PROJECT=agentgateway-weave

# How the gateway identifies itself in Weave.
GATEWAY_NAME=localdev-agentgateway
GATEWAY_ENV=localdev

# Host port for the gateway (container listens on 4000).
GATEWAY_PORT=4000
